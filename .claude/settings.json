{
  "permissions": {
    "allow": [
      "Bash(cargo fmt:*)",
      "Bash(cargo clippy:*)",
      "Bash(cargo test:*)",
      "Bash(cargo check:*)",
      "Bash(cargo build:*)",
      "Bash(cargo doc:*)",
      "Bash(cargo deny check:*)",
      "Bash(cargo tree:*)",
      "Bash(python scripts/check-control-chars.py)",
      "Bash(python scripts/check-action-pins.py)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "[ -z \"$CLAUDE_CODE_REMOTE\" ] || node \"$CLAUDE_PROJECT_DIR/.claude/hooks/cloud-push-guard.mjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
